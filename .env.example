# PostgreSQL
POSTGRES_USER=localshare
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=localshare

# Backend API
DATABASE_URL=postgresql://localshare:changeme_in_production@postgres:5432/localshare
# Prisma migrations (directUrl). Same as DATABASE_URL unless DATABASE_URL is a
# transaction pooler (e.g. Supabase :6543) - then use the session/direct URL.
DIRECT_URL=postgresql://localshare:changeme_in_production@postgres:5432/localshare
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=90d

# OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/v1/auth/microsoft/callback

# URLs
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Cookie Domain (for cross-subdomain auth in production)
# Set to ".yourdomain.com" (with leading dot) in production
# Leave empty for localhost development
COOKIE_DOMAIN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Storage Provider (local or s3)
# local: Uses local filesystem (/uploads/listings/)
# s3: Any S3-compatible object store (Supabase Storage, Cloudflare R2, ...),
#     configured via S3_* below. Legacy value "r2" behaves like "s3".
STORAGE_PROVIDER=local

# S3-compatible storage (only needed if STORAGE_PROVIDER=s3)
# Supabase: S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#           S3_REGION=<project-region>, S3_FORCE_PATH_STYLE=true
#           S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/<bucket>
# R2:       S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#           S3_REGION=auto, S3_PUBLIC_URL=https://pub-xxx.r2.dev
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=localshare-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# E2E Testing (optional - for automated QA tests)
# Create a dedicated test Google account for automated testing
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
